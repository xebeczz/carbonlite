# Copy to backend/.env (or .env) and adjust as needed. No secrets are required.

# "demo" = illustrative factor values (reports watermarked DEMO)
# "strict" = real factor file; VERIFY_ME rows block counting and report finalization
FACTOR_MODE=demo

# Seed the clearly labelled demo supplier and buyer on first startup.
AUTO_SEED=true

# SQLite by default. Example PostgreSQL URL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/carbonlite
DATABASE_URL=sqlite:///./carbonlite.db
UPLOAD_DIR=./uploads

# Optional OpenAI-compatible vision/text extraction. Leave blank for offline fallbacks.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_VISION_MODEL=gpt-4o
LLM_TEXT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Comma-separated. Vite proxies /api in development, so this is only for direct access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15

# Frontend (optional): override the API base URL. Defaults to /api via the Vite proxy.
# VITE_API_URL=http://127.0.0.1:8000/api
