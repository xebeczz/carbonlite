# CarbonLite backend configuration
# Copy to .env and fill what you have. Everything has a working offline fallback.

# "demo" loads backend/data/factors.demo.csv (illustrative, clearly labelled values)
# "strict" loads backend/data/factors.csv (VERIFY_ME placeholders block reports until filled)
FACTOR_MODE=demo

# Auto-create the demo workspace on first startup when the DB is empty.
AUTO_SEED=true

# SQLite by default. Point at Postgres for production: postgresql+psycopg://...
DATABASE_URL=sqlite:///./carbonlite.db
UPLOAD_DIR=./uploads

# Optional: OpenAI-compatible vision/text LLM for document extraction and recommendations.
# Without a key CarbonLite uses the PDF text reader + manual entry, and grounded heuristic recommendations.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_VISION_MODEL=gpt-4o
LLM_TEXT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Comma separated. The Vite dev server proxies /api so CORS is only needed for direct access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
